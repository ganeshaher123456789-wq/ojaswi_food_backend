# ========================================================
# OJASWI FOODS / OJASWI PREMIUM - BACKEND ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to .env and configure with your credentials for local development.
# For Render deployment, configure these key-value pairs in Render Web Service -> Environment.

# --------------------------------------------------------
# 1. Server & Environment
# --------------------------------------------------------
PORT=5000
NODE_ENV=development

# Deployed Frontend URL (for Vercel CORS whitelist, e.g. https://ojaswi.vercel.app)
# Leave blank or set to http://localhost:3000 during local development
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------
# 2. Database Configuration
# --------------------------------------------------------
# MongoDB Atlas Cloud Database Connection String:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ojaswi?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=ojaswi

# Optional PostgreSQL Connection URL (if using Neon, Supabase, Railway, AWS RDS):
DATABASE_URL=

# Note: If MONGODB_URI and DATABASE_URL are left blank, the server automatically
# uses the embedded SQLite database (backend/database/ojaswi.db) for local testing.

# --------------------------------------------------------
# 3. Authentication & Security Secrets
# --------------------------------------------------------
JWT_SECRET=ojaswi-production-jwt-secret-replace-with-secure-32char-key
SESSION_SECRET=ojaswi-session-salt-malegaon-replace-with-secure-key

# Default Administrator Credentials
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=OjaswiAdmin@2026
ADMIN_DEFAULT_EMAIL=admin@ojaswifoods.com

# --------------------------------------------------------
# 4. SMS Provider ('console' | 'fast2sms' | 'twilio' | 'msg91')
# --------------------------------------------------------
# Use 'console' for free local/dev simulation without incurring carrier SMS costs
SMS_PROVIDER=console
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --------------------------------------------------------
# 5. Email Provider ('console' | 'smtp')
# --------------------------------------------------------
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ojaswi Premium" <noreply@ojaswifoods.com>
COMPANY_NOTIFY_EMAIL=ojaswifoods@gmail.com

# --------------------------------------------------------
# 6. WhatsApp Business API ('console' | 'meta_cloud' | 'twilio')
# --------------------------------------------------------
WHATSAPP_PROVIDER=console
WHATSAPP_OWNER_NUMBER=917620098478
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --------------------------------------------------------
# 7. Razorpay Payment Gateway
# --------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
